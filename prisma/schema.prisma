generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters", "multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["workout_app"]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("")
  age          Int?
  weight       Float?
  weightLog    Json     @default("[]")
  shareWeights Boolean  @default(false)
  createdAt    DateTime @default(now())

  authSessions            AuthSession[]
  workoutSessions         WorkoutSession[]
  programs                Program[]
  plannedWorkouts         PlannedWorkout[]
  customExercises         CustomExercise[]
  pushSubscriptions       PushSubscription[]
  sentFriendRequests      FriendRequest[]     @relation("FriendRequestsSent")
  receivedFriendRequests  FriendRequest[]     @relation("FriendRequestsReceived")
  reactions               Reaction[]

  @@schema("workout_app")
}

model FriendRequest {
  id          String    @id @default(cuid())
  fromUserId  String
  fromUser    User      @relation("FriendRequestsSent", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User      @relation("FriendRequestsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  status      String    @default("PENDING")
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  @@unique([fromUserId, toUserId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@schema("workout_app")
}

model Reaction {
  id        String         @id @default(cuid())
  sessionId String
  session   WorkoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String         @default("LIKE")
  createdAt DateTime       @default(now())

  @@unique([sessionId, userId])
  @@index([sessionId])
  @@schema("workout_app")
}

model AuthSession {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@schema("workout_app")
}

model WorkoutSession {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date       String
  title      String
  startedAt  DateTime
  finishedAt DateTime?
  programId  String?
  color      String
  exercises  Json
  createdAt  DateTime @default(now())
  reactions  Reaction[]

  @@index([userId, date])
  @@schema("workout_app")
}

model Program {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  color     String
  exercises Json
  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("workout_app")
}

model PlannedWorkout {
  id                    String    @id @default(cuid())
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  date                  String
  time                  String?
  programId             String?
  title                 String
  color                 String
  reminderMinutesBefore Int?
  remindAt              DateTime?
  reminderSentAt        DateTime?
  createdAt             DateTime  @default(now())

  @@index([userId, date])
  @@schema("workout_app")
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("workout_app")
}

model CustomExercise {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  category  String
  equipment String
  createdAt DateTime @default(now())

  @@index([userId])
  @@schema("workout_app")
}
